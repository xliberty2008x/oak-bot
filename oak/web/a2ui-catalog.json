{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:oak:a2ui:canonical:v1",
  "catalogId": "urn:oak:a2ui:canonical:v1",
  "components": {
    "Column": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,64}$"
        },
        "component": {
          "const": "Column"
        },
        "children": {
          "allOf": [
            {
              "$ref": "https://raw.githubusercontent.com/a2ui-project/a2ui/db4306536438df46e4f0443b9c4ec0d5f1a42dc4/specification/v0_9_1/json/common_types.json#/$defs/ChildList"
            },
            {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[A-Za-z0-9_-]{1,64}$"
              },
              "uniqueItems": true,
              "maxItems": 64
            }
          ]
        }
      },
      "required": [
        "id",
        "component",
        "children"
      ],
      "additionalProperties": false
    },
    "Card": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,64}$"
        },
        "component": {
          "const": "Card"
        },
        "child": {
          "allOf": [
            {
              "$ref": "https://raw.githubusercontent.com/a2ui-project/a2ui/db4306536438df46e4f0443b9c4ec0d5f1a42dc4/specification/v0_9_1/json/common_types.json#/$defs/ComponentId"
            },
            {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]{1,64}$"
            }
          ]
        }
      },
      "required": [
        "id",
        "component",
        "child"
      ],
      "additionalProperties": false
    },
    "Text": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,64}$"
        },
        "component": {
          "const": "Text"
        },
        "text": {
          "oneOf": [
            {
              "type": "string",
              "maxLength": 4000
            },
            {
              "type": "object",
              "properties": {
                "path": {
                  "type": "string",
                  "pattern": "^/",
                  "maxLength": 256
                }
              },
              "required": [
                "path"
              ],
              "additionalProperties": false
            }
          ]
        },
        "variant": {
          "enum": [
            "body",
            "heading",
            "hint"
          ]
        }
      },
      "required": [
        "id",
        "component",
        "text"
      ],
      "additionalProperties": false
    },
    "TextField": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,64}$"
        },
        "component": {
          "const": "TextField"
        },
        "label": {
          "type": "string",
          "maxLength": 200
        },
        "value": {
          "type": "object",
          "properties": {
            "path": {
              "type": "string",
              "pattern": "^/",
              "maxLength": 256
            }
          },
          "required": [
            "path"
          ],
          "additionalProperties": false
        },
        "required": {
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "component",
        "label",
        "value"
      ],
      "additionalProperties": false
    },
    "ChoicePicker": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,64}$"
        },
        "component": {
          "const": "ChoicePicker"
        },
        "label": {
          "type": "string",
          "maxLength": 200
        },
        "value": {
          "type": "object",
          "properties": {
            "path": {
              "type": "string",
              "pattern": "^/",
              "maxLength": 256
            }
          },
          "required": [
            "path"
          ],
          "additionalProperties": false
        },
        "required": {
          "type": "boolean"
        },
        "options": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": {
            "type": "object",
            "properties": {
              "label": {
                "type": "string",
                "maxLength": 200
              },
              "value": {
                "type": "string",
                "maxLength": 100
              }
            },
            "required": [
              "label",
              "value"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "id",
        "component",
        "label",
        "value",
        "options"
      ],
      "additionalProperties": false
    },
    "Button": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,64}$"
        },
        "component": {
          "const": "Button"
        },
        "label": {
          "type": "string",
          "maxLength": 200
        },
        "variant": {
          "enum": [
            "primary",
            "quiet",
            "danger"
          ]
        },
        "action": {
          "type": "object",
          "properties": {
            "event": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9_-]{1,64}$"
                },
                "context": {
                  "type": "object",
                  "maxProperties": 32,
                  "additionalProperties": {
                    "oneOf": [
                      {
                        "type": "object",
                        "properties": {
                          "path": {
                            "type": "string",
                            "pattern": "^/",
                            "maxLength": 256
                          }
                        },
                        "required": [
                          "path"
                        ],
                        "additionalProperties": false
                      },
                      {
                        "type": [
                          "string",
                          "number",
                          "boolean",
                          "null"
                        ]
                      }
                    ]
                  }
                }
              },
              "required": [
                "name"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "event"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "id",
        "component",
        "label",
        "action"
      ],
      "additionalProperties": false
    }
  },
  "functions": {},
  "$defs": {
    "anyComponent": {
      "oneOf": [
        {
          "$ref": "#/components/Column"
        },
        {
          "$ref": "#/components/Card"
        },
        {
          "$ref": "#/components/Text"
        },
        {
          "$ref": "#/components/TextField"
        },
        {
          "$ref": "#/components/ChoicePicker"
        },
        {
          "$ref": "#/components/Button"
        }
      ]
    },
    "anyFunction": false,
    "theme": {
      "type": "object",
      "maxProperties": 0
    }
  },
  "description": "Oak canonical DOM catalogue 1.0.0, pinned A2UI v0.9.1. Object paths only; single ChoicePicker value is string[]. Tree structure only. No functions, theme overrides, HTML, URLs or scripts."
}
