[Unit]
Description=Oak trusted OpenAI STT broker with local NeMo fallback
Requires=oak-stt.socket
After=oak-stt.socket
StartLimitIntervalSec=300
StartLimitBurst=3

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/oak-stt-openai
ExecStart=/usr/bin/python3 /home/ubuntu/oak-stt-openai/service/server.py
EnvironmentFile=-/home/ubuntu/oak-stt-openai/secrets/openai.env
PassEnvironment=HTTP_PROXY HTTPS_PROXY ALL_PROXY NO_PROXY http_proxy https_proxy all_proxy no_proxy SSL_CERT_FILE SSL_CERT_DIR
StateDirectory=oak-stt-openai
StateDirectoryMode=0700
UMask=0077
Restart=on-failure
RestartSec=5
TimeoutStopSec=10
KillMode=control-group
Nice=10
CPUQuota=10%
MemoryHigh=200M
MemoryMax=250M
OOMPolicy=stop
TasksMax=24
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
StandardOutput=null
StandardError=null
